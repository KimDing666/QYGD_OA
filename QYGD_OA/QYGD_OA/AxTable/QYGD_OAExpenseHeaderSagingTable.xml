		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static QYGD_OAExpenseHeaderSagingTable find(String30   _expenseNum,
                                                       DataAreaId _owenEntity,
                                                       boolean    _forUpdate = false)

    {
        QYGD_OAExpenseHeaderSagingTable expenseHeaderSagingTable;

        if (_expenseNum && _owenEntity)
        {
            expenseHeaderSagingTable.selectForUpdate(_forUpdate);

            select firstonly expenseHeaderSagingTable
                index ExpenseIdx
                where expenseHeaderSagingTable.ExpenseNum == _expenseNum 
                   && expenseHeaderSagingTable.OwenEntity    == _owenEntity;
        }
        return expenseHeaderSagingTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    public void initValue()
    {
        super();

        this.PaymentType    = IWS_PaymentType::Reimburse;
    }

]]></Source>
			</Method>
